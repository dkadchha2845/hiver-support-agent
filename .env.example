# Everything below is optional. With no .env at all the pipeline runs entirely on
# local open-weights models through Ollama, which is how the committed results were
# produced. No API key, no account, no spend.

# --- which brand to build the agent for
BRAND=SpotifyCares

# --- agent model (the thing being evaluated)
AGENT_PROVIDER=ollama
AGENT_MODEL=qwen2.5:7b-instruct

# --- judge model. Deliberately a different family from the agent.
JUDGE_PROVIDER=ollama
JUDGE_MODEL=llama3.1:8b-instruct-q4_K_M

OLLAMA_HOST=http://localhost:11434

# --- optional free-tier hosted alternatives, if you would rather not run locally.
#     Groq and Google both have free tiers that cover this workload.
# AGENT_PROVIDER=groq
# AGENT_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=...
#
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=...
#
# AGENT_PROVIDER=openrouter
# OPENROUTER_API_KEY=...
